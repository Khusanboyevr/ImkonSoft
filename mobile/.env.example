# Where the contact form posts. Must be a host running this repo's Next.js app,
# because /api/contact is what holds the Telegram credentials.
#
# Production is the default and needs no entry here. Copy this file to .env and
# set the value while developing against a local site:
#
#   - Android emulator -> http://10.0.2.2:3000
#   - iOS simulator    -> http://localhost:3000
#   - Real phone       -> http://<your-computer-LAN-IP>:3000
#
# Anything prefixed EXPO_PUBLIC_ is bundled into the app and readable by anyone
# who downloads it, so never put a token or password here.
EXPO_PUBLIC_API_BASE_URL=https://revengroup.uz
